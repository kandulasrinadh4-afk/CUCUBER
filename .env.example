# SPORTMONKS_API_TOKEN: Primary cricket data provider API token (https://docs.sportmonks.com/cricket/).
# Configure via server environment / Secrets panel. Never expose in client code or GitHub.
SPORTMONKS_API_TOKEN=MY_SPORTMONKS_API_TOKEN

# CRICKETDATA_API_KEY: Optional secondary cricket provider API key (CricketData.org).
# Leave empty unless enabling the optional secondary provider adapter.
CRICKETDATA_API_KEY=

# CRICKET_NEWS_RSS_FEEDS: Optional comma-separated HTTPS RSS feed URLs to supplement default cricket feeds.
CRICKET_NEWS_RSS_FEEDS=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
