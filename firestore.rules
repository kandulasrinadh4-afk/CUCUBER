rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Accepts letters, numbers, underscores, and hyphens (up to 128 characters)
    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_-]+$') && id.size() > 0 && id.size() <= 128;
    }

    // Validates guest client IDs
    function isGuestId(id) {
      return id is string && id.matches('^guest_[a-zA-Z0-9_-]+$') && id.size() > 6 && id.size() <= 64;
    }

    // Connection testing endpoint for client initialization verification
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles & settings: strictly owner-only read & write
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Live Match Fan Reactions & Cheers (Publicly readable, authenticated or verified guest create)
    match /matches/{matchId}/reactions/{reactionId} {
      allow read: if isValidId(matchId);
      allow create: if isValidId(matchId)
                    && isValidId(reactionId)
                    && ((isSignedIn() && request.resource.data.userId == request.auth.uid) || (!isSignedIn() && isGuestId(request.resource.data.userId)))
                    && request.resource.data.keys().hasAll(['id', 'matchId', 'userId', 'userName', 'reactionType', 'createdAt'])
                    && request.resource.data.matchId == matchId
                    && request.resource.data.id == reactionId
                    && request.resource.data.reactionType in ['six', 'wicket', 'cheer', 'fire', 'shock', 'clutch']
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() > 0
                    && request.resource.data.userName.size() <= 60
                    && (request.resource.data.createdAt is number || request.resource.data.createdAt is timestamp)
                    && request.resource.data.get('message', '') is string
                    && request.resource.data.get('message', '').size() <= 140;
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid);
    }

    // Community Match Prediction Polls (Publicly readable, atomic tally updates)
    match /community_polls/{pollId} {
      allow read: if isValidId(pollId);
      allow create: if isValidId(pollId)
                    && request.resource.data.options is list
                    && request.resource.data.totalVotes is number;
      allow update: if isValidId(pollId)
                    && request.resource.data.options is list
                    && request.resource.data.totalVotes is number;
      allow delete: if false;

      // Individual user votes (1 vote per user, update disallowed to prevent tampering)
      match /votes/{userId} {
        allow read: if isValidId(pollId);
        allow create: if isValidId(pollId)
                      && ((isSignedIn() && isOwner(userId) && request.resource.data.userId == request.auth.uid)
                          || (!isSignedIn() && isGuestId(userId) && request.resource.data.userId == userId))
                      && request.resource.data.userId == userId
                      && request.resource.data.selectedOption is string
                      && request.resource.data.selectedOption.size() > 0
                      && request.resource.data.selectedOption.size() <= 64;
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }
  }
}
